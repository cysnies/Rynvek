{
  "name": "@rynvek/desktop-shell",
  "version": "0.1.0",
  "description": "Rynvek 桌面客户端宿主外壳：管理本地 SQLite 存储目录、原生 wgpu 设备策略与进程内权威服务桥接",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rynvek/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
