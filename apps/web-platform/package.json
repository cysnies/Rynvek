{
  "name": "@rynvek/web-platform",
  "version": "0.1.0",
  "description": "Rynvek Web 平台旗舰宿主应用：集成 Arena 竞技场、Studio 实时协作编辑器、Lab 演化实验室与 Hub 门户",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node tools/build-wasm.mjs && tsc -p tsconfig.build.json && vite build --config vite.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node tools/build-wasm.mjs && vite --config vite.config.mjs",
    "build:web": "node tools/build-wasm.mjs && vite build --config vite.config.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "test:wasm": "node --test tools/wasm-abi.test.mjs"
  },
  "dependencies": {
    "@rynvek/agent-sdk": "workspace:*",
    "@rynvek/arena": "workspace:*",
    "@rynvek/assets": "workspace:*",
    "@rynvek/audio": "workspace:*",
    "@rynvek/client": "workspace:*",
    "@rynvek/core": "workspace:*",
    "@rynvek/engine": "workspace:*",
    "@rynvek/lab": "workspace:*",
    "@rynvek/studio": "workspace:*",
    "@rynvek/ui": "workspace:*",
    "@rynvek/visualization": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.4"
  }
}
