{
  "name": "@rynvek/studio",
  "version": "0.1.0",
  "description": "Rynvek Studio 创作环境：Dockable Workspace、WorldPatch CRDT 实时编辑补丁、四级热更新调度与仿真控制",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
