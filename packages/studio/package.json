    "@rynvek/core": "workspace:*",
    "@rynvek/engine": "workspace:*",
    "@rynvek/ui": "workspace:*",
    "@rynvek/visualization": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
