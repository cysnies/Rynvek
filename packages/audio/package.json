{
  "name": "@rynvek/audio",
  "version": "0.1.0",
  "description": "Rynvek 程序化音频：24 类 Web Audio 占位合成音效、五总线混音、AudioManifest 与自适应音乐分轨",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
