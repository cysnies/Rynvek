"""原生扩展 ``rynvek._native`` 的类型存根。"""

import pyarrow as pa

__version__: str
FEATURE_NAMES: list[str]
MACRO_ACTIONS: list[str]
POLICY_INTERVAL_TICKS: int
MAX_TICKS: int

class RynvekError(Exception):
    """args = (code: int, name: str, message: str)"""

class ArenaSim:
    def __init__(self, mode: str = "duel", seed: int = 0, players: int | None = None) -> None: ...
    @staticmethod
    def from_rworld(data: bytes) -> ArenaSim: ...
    def reset(self, seed: int | None = None) -> None: ...
    @property
    def tick(self) -> int: ...
    @property
    def mode(self) -> str: ...
    @property
    def seed(self) -> int: ...
    @property
    def players(self) -> list[int]: ...
    def is_over(self) -> bool: ...
    def state_root(self) -> bytes: ...
    def outcome(self) -> dict[str, object] | None: ...
    def step(self, n: int = 1) -> int: ...
    def apply_macro(self, faction: int, action: int) -> tuple[int, int]: ...
    def run_policy(self, faction: int, policy: str) -> tuple[int, int]: ...
    def apply_command(self, faction: int, command_json: str) -> None: ...
    def features(self, faction: int) -> pa.Int64Array: ...
    def units(self, faction: int) -> pa.RecordBatch: ...

class Experiment:
    @property
    def run_count(self) -> int: ...
    def table(self, name: str) -> pa.RecordBatch: ...
    def parquet(self, name: str) -> bytes: ...

def run_experiment(spec_json: str) -> Experiment: ...
