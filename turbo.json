{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "../../tests/golden_vectors/**",
        "../../tests/rules/**",
        "../../tests/engine/**",
        "../../docs/**",
        "../../protocols/**",
        "../../crates/rynvek-render/src/**"
      ]
    }
  }
}
