{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rynvek.org/schemas/general-world.schema.json",
  "title": "通用单 Chunk 圆形刚体世界，可选有来源生命与受控声明组件（实现剖面 v1）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "bodies"
  ],
  "properties": {
    "schema": {
      "const": "rynvek.general-world.v1"
    },
    "profile": {
      "const": "rynvek.general-circle-ecs.v1"
    },
    "bodies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_q32",
          "velocity_q32",
          "acceleration_q32",
          "radius_q32",
          "mass_q32",
          "fixed"
        ],
        "properties": {
          "position_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1073741824,
              "maximum": 1098437885952
            },
            "minItems": 2,
            "maxItems": 2
          },
          "velocity_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -34359738368,
              "maximum": 34359738368
            },
            "minItems": 2,
            "maxItems": 2
          },
          "acceleration_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -137438953472,
              "maximum": 137438953472
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius_q32": {
            "type": "integer",
            "minimum": 1073741824,
            "maximum": 8589934592
          },
          "mass_q32": {
            "type": "integer",
            "minimum": 4294967296,
            "maximum": 4398046511104
          },
          "fixed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "fixed": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "velocity_q32": {
                  "const": [
                    0,
                    0
                  ]
                },
                "acceleration_q32": {
                  "const": [
                    0,
                    0
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "life": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "nutrient_deposits"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "max_ingest_raw_per_tick",
            "maintenance_q_per_tick",
            "recycle_percent"
          ],
          "properties": {
            "profile": {
              "const": "rynvek.general-sourced-life.v1"
            },
            "max_ingest_raw_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "maintenance_q_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            },
            "recycle_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "neural": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hidden",
                "weights_base_q8"
              ],
              "properties": {
                "hidden": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "weights_base_q8": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  }
                }
              }
            }
          }
        },
        "nutrient_deposits": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "value"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32767
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "world_seed",
        "gas_budget",
        "rule_cost_micro_per_gas",
        "templates",
        "instances",
        "bindings",
        "rule_graphs",
        "tier1_rules",
        "body_controllers"
      ],
      "properties": {
        "profile": {
          "const": "rynvek.general-components.v1"
        },
        "world_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "gas_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        },
        "rule_cost_micro_per_gas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "templates": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "components"
            ],
            "properties": {
              "schema": {
                "const": "rynvek.parameter-template.v1"
              },
              "components": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^(state|param)\\.[a-z0-9]+([._-][a-z0-9]+)*$",
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ty",
                    "default"
                  ],
                  "properties": {
                    "ty": {
                      "enum": [
                        "I32",
                        "Q8_8",
                        "Bool"
                      ]
                    },
                    "default": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "ty": {
                            "const": "Q8_8"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "default": {
                            "minimum": -32768,
                            "maximum": 32767
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "ty": {
                            "const": "Bool"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "default": {
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      }
                    }
                  ]
                },
                "minProperties": 1
              }
            }
          }
        },
        "instances": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template_id",
              "parameters"
            ],
            "properties": {
              "template_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^param\\."
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            }
          }
        },
        "bindings": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "template_id"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "template_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "maxLength": 128
              }
            }
          }
        },
        "rule_graphs": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "tier1_rules": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template_id",
              "package_hex"
            ],
            "properties": {
              "template_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "package_hex": {
                "type": "string",
                "pattern": "^([0-9a-fA-F]{2})*$",
                "maxLength": 24576
              }
            }
          }
        },
        "body_controllers": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instance_id",
              "entity_serial"
            ],
            "properties": {
              "instance_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "entity_serial": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            }
          }
        }
      },
      "description": "创世显式安装。跨引用、单写者、实际编译、模板类型与有来源身体定价由原RYWL解析器复核；不是任意组件/TS或私有签名发布链。"
    }
  }
}
