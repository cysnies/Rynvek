{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rynvek.org/schemas/general-world.schema.json",
  "title": "通用单 Chunk 圆形刚体世界（实现剖面 v1）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "bodies"
  ],
  "properties": {
    "schema": {
      "const": "rynvek.general-world.v1"
    },
    "profile": {
      "const": "rynvek.general-circle-ecs.v1"
    },
    "bodies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_q32",
          "velocity_q32",
          "acceleration_q32",
          "radius_q32",
          "mass_q32",
          "fixed"
        ],
        "properties": {
          "position_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1073741824,
              "maximum": 1098437885952
            },
            "minItems": 2,
            "maxItems": 2
          },
          "velocity_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -34359738368,
              "maximum": 34359738368
            },
            "minItems": 2,
            "maxItems": 2
          },
          "acceleration_q32": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -137438953472,
              "maximum": 137438953472
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius_q32": {
            "type": "integer",
            "minimum": 1073741824,
            "maximum": 8589934592
          },
          "mass_q32": {
            "type": "integer",
            "minimum": 4294967296,
            "maximum": 4398046511104
          },
          "fixed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "fixed": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "velocity_q32": {
                  "const": [
                    0,
                    0
                  ]
                },
                "acceleration_q32": {
                  "const": [
                    0,
                    0
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
